# Database connection string (Supabase PostgreSQL via psycopg, or SQLite for local dev/testing)
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
TEST_DATABASE_URL=sqlite:///:memory:

# AI Configuration
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash

# TTL Configurations (in minutes)
QUOTE_TTL_MINUTES=15
APPROVAL_TTL_MINUTES=15

# Security & Environment
DEMO_ADMIN_TOKEN=demo-admin-secret-token-change-in-production
DEMO_ALLOWED_ENVS=["dev","development","staging","demo"]
AI_REWORD_ENABLED=false
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
